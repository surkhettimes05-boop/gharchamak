# Canonical public origin used for metadata, sitemap, robots and JSON-LD.
# Example: https://gharchamak.com
NEXT_PUBLIC_SITE_URL=

# Optional integrations. Leave empty to disable.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# GharChamak Admin CMS
# Provision Neon Postgres through the Vercel Marketplace and paste its connection
# string here for local development. Vercel can inject DATABASE_URL automatically.
DATABASE_URL=

# Single-owner V1 admin authentication. Keep these server-side only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate a long random secret (32+ bytes recommended).
ADMIN_SESSION_SECRET=

# Vercel Blob token for admin media uploads. Direct server uploads are limited
# to 4 MB by this app; larger videos should be hosted externally and added by URL.
BLOB_READ_WRITE_TOKEN=
